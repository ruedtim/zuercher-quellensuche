# Lokale Dev-Konfig fuer SvelteKit. Kopiere zu .env und passe an.

MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev_master_key_change_me
MEILI_INDEX=documents

EMBED_URL=http://localhost:8001

# Pfad zum Indexer-Output (rendered HTML + IIIF). In Dev liest SvelteKit direkt
# aus dem Filesystem. In Prod ist das leer und RENDER_BASE_URL wird genutzt.
RENDER_LOCAL_DIR=../../services/indexer/output
RENDER_BASE_URL=

PUBLIC_BASE_URL=http://localhost:5173
