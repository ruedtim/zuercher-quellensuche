# Kopie nach infra/.env; gelesen von docker compose (infra/compose.yml).
# Die Website liest apps/web/.env (Vorlage apps/web/.env.example), der Indexer seine Umgebung.

# --- Meilisearch ---
MEILI_MASTER_KEY=dev_master_key_change_me
MEILI_URL=http://localhost:7700
MEILI_INDEX=documents

# --- Embed-Dienst ---
ZSZH_MODEL=jinaai/jina-embeddings-v2-base-de
EMBED_URL=http://localhost:8001

# --- Indexer ---
# Ordner mit data/<Serie>/<id>.xml
ZSZH_DATA_DIR=/pfad/zum/tei-korpus
# Ausgabe für HTML, TEI und IIIF-Manifeste (apps/web/.env.example liest ../../services/indexer/output)
RENDER_OUTPUT_DIR=./output
# Basis der IIIF-Bilder
IIIF_IMAGE_API_BASE=https://media.sources-online.org/cantaloupe/iiif/2
PUBLIC_BASE_URL=http://localhost:5173
