# services/ner-xml – NER-Parameter (nach .env kopieren und anpassen).
# Werte wie in ner_api/.env des Repos machinelearningZH/named-entity-recognition_staatsarchiv.

# SpanMarker-Modell (HF-Hub-ID, wird zur Laufzeit geladen)
SM_MODEL=team-data-ktzh/span-marker-ktzh-stazh

# Gerät: cpu | mps (Apple Silicon) | cuda (GPU-Server)
DEVICE=cpu

# SpanMarker-Batchgröße (höher = schneller, mehr Speicher; ändert Resultate nicht)
BATCH_SIZE=4

# Pro-Label-Schwellen für Ableitungen (deriv); per --device/CLI nicht überschreibbar
NE_THRESHOLDS={"LOCderiv":0.08, "ORGderiv":0.9, "PERderiv":0.87}

# Zusätzliche Satzgrenzen-Zeichen (Semikolon, Doppelpunkt)
ADDITIONAL_PUNCTUATION=[";", ":"]

# Überlange Sätze splitten, um das SpanMarker-Token-Limit einzuhalten
SPLIT_OVERLONG_SENTENCES=true
